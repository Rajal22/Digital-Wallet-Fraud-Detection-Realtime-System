# Copy this to .env and fill in real values. Never commit the real .env.

# --- Database mode: memory | local | astra ---
DB_MODE=memory

# --- Only needed if DB_MODE=local (self-hosted/Docker Cassandra) ---
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fraud_detection

# --- Only needed if DB_MODE=astra (DataStax Astra DB) ---
ASTRA_SECURE_CONNECT_BUNDLE=/path/to/secure-connect-yourdb.zip
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your-token-here
ASTRA_KEYSPACE=fraud_detection

# --- Frontend ---
API_URL=http://127.0.0.1:8000
